        "value": "de.eferu.helix.HelixClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1-",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10"
  }
}
